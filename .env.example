# Copy this file to `.env` and adjust values. Never commit `.env`.
# Booleans accept: true/false, 1/0, yes/no, on/off (case-insensitive).
# Lists are comma-separated; surrounding whitespace and empty entries are ignored.

# Required when DJANGO_DEBUG is false (startup fails without it). When DEBUG is
# true and this is empty, an insecure development-only key is used. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Never enable in production.
DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins including the scheme, e.g. https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=UTC

# Database. If unset, a local SQLite file (db.sqlite3) is used.
# PostgreSQL example:
# DATABASE_URL=postgres://app_user:app_password@localhost:5432/app_db

# Seconds to keep database connections open (0 = close after each request).
DATABASE_CONN_MAX_AGE=60

DJANGO_LOG_LEVEL=INFO

# Email (used for password reset). Defaults to printing emails to the console.
# For real delivery use e.g. django.core.mail.backends.smtp.EmailBackend plus Django's
# EMAIL_* settings.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_DEFAULT_FROM_EMAIL="cursuri.net <no-reply@localhost>"

# --- Python code runner ---
# Learner code runs only inside isolated Docker containers. Leave the backend empty (disabled)
# unless Docker is available; there is no local fallback. Pull the image first:
#   docker pull python:3.11-slim
# In production, pin the image to an immutable digest (python@sha256:...).
PYTHON_RUNNER_BACKEND=
# PYTHON_RUNNER_BACKEND=docker
PYTHON_RUNNER_IMAGE=python:3.11-slim
PYTHON_RUNNER_TIMEOUT_SECONDS=3
PYTHON_RUNNER_MEMORY_MB=128
PYTHON_RUNNER_CPUS=0.5
PYTHON_RUNNER_PIDS_LIMIT=64
PYTHON_RUNNER_MAX_OUTPUT_BYTES=65536
PYTHON_RUNNER_MAX_SOURCE_BYTES=65536
PYTHON_RUNNER_DOCKER_BINARY=docker

# --- AI tutor ---
# Off by default. The tutor uses the OpenAI Responses API (store=false); Django stays the source
# of truth for correctness, mastery and progression. Never commit a real API key.
AI_TUTOR_ENABLED=false
# AI_TUTOR_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_SECONDS=20
AI_TUTOR_HISTORY_TURNS=8
AI_TUTOR_MAX_USER_CHARS=4000
AI_TUTOR_MAX_OUTPUT_TOKENS=800
AI_TUTOR_RATE_LIMIT_PER_MINUTE=20

# --- Production security (only take effect when DJANGO_DEBUG is false) ---
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0

# Enable ONLY when running behind a trusted reverse proxy that always sets
# X-Forwarded-Proto and strips any client-supplied value. Otherwise clients
# could spoof HTTPS.
DJANGO_SECURE_PROXY_SSL_HEADER=false
